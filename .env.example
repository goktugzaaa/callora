# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Postgres + Auth + Row-Level Security) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# "Publishable" key (or the legacy "anon" key: NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (or the legacy "service_role" key: SUPABASE_SERVICE_ROLE_KEY). Server only.
SUPABASE_SECRET_KEY=
# Session pooler connection string, used by `npm run db:push`
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- AI -------------------------------------------------------------------------
# "provider/model". google/* uses GEMINI_API_KEY directly; anything else goes
# through the Vercel AI Gateway (AI_GATEWAY_API_KEY locally, OIDC on Vercel).
AI_MODEL=google/gemini-3.8-flash
GEMINI_API_KEY=
AI_GATEWAY_API_KEY=

# --- WhatsApp Business Platform (Cloud API) --------------------------------------
# From your Meta app: webhook verify token (any random string you also enter in Meta)
WHATSAPP_VERIFY_TOKEN=
# Meta app secret, used to verify X-Hub-Signature-256 on every webhook
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0

# 32 random bytes, base64. Encrypts stored WhatsApp access tokens.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- App ------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demo login created by `npm run db:seed`
DEMO_USER_EMAIL=demo@callora.app
DEMO_USER_PASSWORD=
# Optional: granted platform-admin access by `npm run db:seed` once signed up
PLATFORM_ADMIN_EMAIL=
